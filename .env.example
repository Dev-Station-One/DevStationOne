DEVSTATION_ENV=development
DEVSTATION_LOG_LEVEL=info

# devstation-server
DEVSTATION_SERVER_ADDR=:8080
DEVSTATION_DATABASE_URL=postgres://devstation:devstation@localhost:55432/devstation?sslmode=disable
# Set on first run only: creates the initial administrator if no users exist yet.
DEVSTATION_ADMIN_EMAIL=
DEVSTATION_ADMIN_PASSWORD=

# devstation-runtime
DEVSTATION_SERVER_URL=ws://localhost:8080
# Enrollment token issued by POST /api/v1/runtimes (shown once).
DEVSTATION_RUNTIME_TOKEN=
