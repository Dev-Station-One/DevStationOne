DEVSTATIONONE_ENV=development
DEVSTATIONONE_LOG_LEVEL=info

# devstationone-server
DEVSTATIONONE_SERVER_ADDR=:8080
DEVSTATIONONE_DATABASE_URL=postgres://devstation:devstation@localhost:55432/devstation?sslmode=disable
# Set on first run only: creates the initial administrator if no users exist yet.
DEVSTATIONONE_ADMIN_EMAIL=
DEVSTATIONONE_ADMIN_PASSWORD=
# Encrypts stored database-connection credentials (docs/SECURITY.md). 32 raw
# bytes, base64-encoded. Generate with: openssl rand -base64 32
DEVSTATIONONE_DB_ENCRYPTION_KEY=

# devstationone-runtime
DEVSTATIONONE_SERVER_URL=ws://localhost:8080
# Enrollment token issued by POST /api/v1/runtimes (shown once).
DEVSTATIONONE_RUNTIME_TOKEN=
